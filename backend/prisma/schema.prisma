generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum user_role {
  ADMIN
  ENTERPRISE_MANAGER
  CUSTOMER
}

enum user_status {
  ACTIVE
  SUSPENDED
}

enum enterprise_status {
  PENDING
  VERIFIED
}

enum verification_status {
  PENDING
  VERIFIED
  REJECTED
  REQUIRED
}

model users {
  id                  String      @id @default(uuid()) @db.Uuid
  name                String      @db.VarChar(255)
  email               String      @unique @db.VarChar(255)
  password_hash       String      @db.VarChar(255)
  role                user_role
  enterprise_id       String?     @db.Uuid
  phone               String?     @db.VarChar(255)
  phone_verified      Boolean     @default(false)
  profile_picture_key String?     @db.VarChar(255)
  email_verified      Boolean     @default(false)
  status              user_status @default(ACTIVE)
  created_at          DateTime    @default(now()) @db.Timestamptz
  updated_at          DateTime    @updatedAt @db.Timestamptz
  suspended_at        DateTime?   @db.Timestamptz
  suspension_reason   String?     @db.Text

  enterprise          enterprises?  @relation("enterprise_members", fields: [enterprise_id], references: [id])
  notifications       notifications[] @relation("user_notifications")
  quotation_requests  quotation_requests[] @relation("customer_quotation_requests")

  @@map("users")
}

model enterprises {
  id              String              @id @default(uuid()) @db.Uuid
  enterprise_name String              @db.VarChar(255)
  category_id     String?             @db.Uuid
  description     String?             @db.Text
  status          enterprise_status   @default(PENDING)
  kyc_status      verification_status @default(REQUIRED)
  bank_status     verification_status @default(REQUIRED)
  verified_at     DateTime?           @db.Timestamptz
  created_at      DateTime            @default(now()) @db.Timestamptz
  updated_at      DateTime            @updatedAt @db.Timestamptz

  users                 users[]                              @relation("enterprise_members")
  kyc                   enterprise_kyc?
  kyc_requests          enterprise_kyc_requests[]
  bank_accounts         enterprise_bank_accounts[]
  bank_account_requests enterprise_bank_accounts_requests[]
  category              categories?                          @relation(fields: [category_id], references: [id])
  subcategories         enterprise_subcategories[]
  quotation_requests enterprise_quotation_requests[]
  proposals             proposals[]

  @@map("enterprises")
}

enum business_type {
  PRIVATE_LIMITED
  PUBLIC_LIMITED
  LLP
  PARTNERSHIP
  SOLE_PROPRIETORSHIP
  OTHER
}

enum document_type {
  AADHAAR
  PASSPORT
  PAN_CARD
  VOTER_ID
  DRIVING_LICENCE
  GST_CERTIFICATE
}

enum kyc_status {
  PENDING
  VERIFIED
  REJECTED
}

enum bank_account_type {
  CURRENT
  SAVINGS
}

enum bank_verification_status {
  PENDING
  VERIFIED
  REJECTED
}

model enterprise_kyc {
  id                   String        @id @default(uuid()) @db.Uuid
  enterprise_id        String        @unique @db.Uuid
  business_type        business_type
  full_legal_name      String        @db.VarChar(255)
  document_type        document_type
  document_storage_key String        @db.Text
  verified_at          DateTime?     @db.Timestamptz
  created_at           DateTime      @default(now()) @db.Timestamptz
  updated_at           DateTime      @updatedAt @db.Timestamptz

  enterprise enterprises @relation(fields: [enterprise_id], references: [id], onDelete: Cascade)

  @@map("enterprise_kyc")
}

model enterprise_kyc_requests {
  id                   String        @id @default(uuid()) @db.Uuid
  enterprise_id        String        @db.Uuid
  business_type        business_type
  full_legal_name      String        @db.VarChar(255)
  document_type        document_type
  document_storage_key String        @db.Text
  status               kyc_status    @default(PENDING)
  rejection_reason     String?       @db.Text
  verified_at         DateTime?     @db.Timestamptz
  created_at           DateTime      @default(now()) @db.Timestamptz
  updated_at           DateTime      @updatedAt @db.Timestamptz

  enterprise           enterprises   @relation(fields: [enterprise_id], references: [id], onDelete: Cascade)

  @@map("enterprise_kyc_requests")
}

model enterprise_bank_accounts {
  id                  String            @id @default(uuid()) @db.Uuid
  enterprise_id       String            @db.Uuid
  account_holder_name String            @db.VarChar(255)
  account_number      String            @db.VarChar(255)
  ifsc_code           String            @db.VarChar(11)
  account_type        bank_account_type
  upi_id              String?           @db.VarChar(255)
  is_primary          Boolean           @default(true)
  verified_at         DateTime?         @db.Timestamptz
  created_at          DateTime          @default(now()) @db.Timestamptz
  updated_at          DateTime          @updatedAt @db.Timestamptz

  enterprise enterprises @relation(fields: [enterprise_id], references: [id], onDelete: Cascade)

  @@index([enterprise_id])
  @@map("enterprise_bank_accounts")
}

model enterprise_bank_accounts_requests {
  id                  String                   @id @default(uuid()) @db.Uuid
  enterprise_id       String                   @db.Uuid
  account_holder_name String                   @db.VarChar(255)
  account_number      String                   @db.VarChar(255)
  ifsc_code           String                   @db.VarChar(11)
  account_type        bank_account_type
  upi_id              String?                  @db.VarChar(255)
  status              bank_verification_status @default(PENDING)
  rejection_reason    String?                  @db.Text
  verified_at         DateTime?                @db.Timestamptz
  created_at          DateTime                 @default(now()) @db.Timestamptz
  updated_at          DateTime                 @updatedAt @db.Timestamptz

  enterprise          enterprises              @relation(fields: [enterprise_id], references: [id], onDelete: Cascade)

  @@map("enterprise_bank_accounts_requests")
}

enum category_status {
  ACTIVE
  INACTIVE
}

enum subcategory_status {
  ACTIVE
  INACTIVE
}

model categories {
  id            String          @id @default(uuid()) @db.Uuid
  name          String          @unique @db.VarChar(255)
  status        category_status @default(ACTIVE)
  created_at    DateTime        @default(now()) @db.Timestamptz
  updated_at    DateTime        @updatedAt @db.Timestamptz

  subcategories      subcategories[]
  enterprises        enterprises[]
  quotation_requests quotation_requests[]

  @@map("categories")
}

model subcategories {
  id          String             @id @default(uuid()) @db.Uuid
  category_id String             @db.Uuid
  name        String             @unique @db.VarChar(255)
  status      subcategory_status @default(ACTIVE)
  created_at  DateTime           @default(now()) @db.Timestamptz
  updated_at  DateTime           @updatedAt @db.Timestamptz

  category           categories                 @relation(fields: [category_id], references: [id])
  enterprises        enterprise_subcategories[]
  quotation_requests quotation_requests[]

  @@map("subcategories")
}

model enterprise_subcategories {
  id             String        @id @default(uuid()) @db.Uuid
  enterprise_id  String        @db.Uuid
  subcategory_id String        @db.Uuid
  created_at     DateTime      @default(now()) @db.Timestamptz

  enterprise     enterprises   @relation(fields: [enterprise_id], references: [id], onDelete: Cascade)
  subcategory    subcategories @relation(fields: [subcategory_id], references: [id], onDelete: Cascade)

  @@unique([enterprise_id, subcategory_id])
  @@index([subcategory_id])
  @@map("enterprise_subcategories")
}

enum notification_type {
  KYC_VERIFIED
  KYC_REJECTED
  BANK_DETAILS_VERIFIED
  BANK_DETAILS_REJECTED
  QUOTATION_RECEIVED
  NEW_PROPOSAL_RECEIVED
  PROPOSAL_ACCEPTED
}

model notifications {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  type       notification_type
  title      String    @db.VarChar(255)
  message    String    @db.Text
  is_read    Boolean   @default(false)
  read_at    DateTime? @db.Timestamptz
  created_at DateTime  @default(now()) @db.Timestamptz

  user       users     @relation("user_notifications", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read, created_at(sort: Desc)])
  @@index([user_id, created_at(sort: Desc), id(sort: Desc)])
  @@map("notifications")
}

enum quotation_request_status {
  PENDING
  PROPOSAL_RECEIVED
  ACCEPTED
  PAID
  COMPLETED
  CANCELLED
}

model quotation_requests {
  id             String                   @id @default(uuid()) @db.Uuid
  customer_id    String                   @db.Uuid
  category_id    String                   @db.Uuid
  subcategory_id String                   @db.Uuid
  product_name   String                   @db.VarChar(255)
  description    String                   @db.Text
  quantity       Int
  budget         Int?
  location       String?                  @db.VarChar(255)
  status         quotation_request_status @default(PENDING)
  created_at     DateTime                 @default(now()) @db.Timestamptz
  updated_at     DateTime                 @updatedAt @db.Timestamptz
  cancelled_at   DateTime?                @db.Timestamptz
  accepted_at    DateTime?                @db.Timestamptz
  paid_at        DateTime?                @db.Timestamptz
  completed_at   DateTime?                @db.Timestamptz


  customer       users                    @relation("customer_quotation_requests", fields: [customer_id], references: [id], onDelete: Cascade)
  category       categories               @relation(fields: [category_id], references: [id])
  subcategory    subcategories            @relation(fields: [subcategory_id], references: [id])
  enterprise_requests enterprise_quotation_requests[]
  proposals      proposals[]

  @@index([customer_id, created_at(sort: Desc)])
  @@index([customer_id, status, created_at(sort: Desc)])
  @@index([category_id])
  @@index([subcategory_id])
  @@map("quotation_requests")
}

enum enterprise_quotation_status {
  OPEN
  PROPOSAL_SENT
  CLOSED
  CANCELLED
}

model enterprise_quotation_requests {
  id             String                      @id @default(uuid()) @db.Uuid
  enterprise_id  String                      @db.Uuid
  quotation_id   String                      @db.Uuid
  status         enterprise_quotation_status @default(OPEN)
  created_at     DateTime                    @default(now()) @db.Timestamptz

  enterprise     enterprises        @relation(fields: [enterprise_id], references: [id], onDelete: Cascade)
  quotation      quotation_requests @relation(fields: [quotation_id], references: [id], onDelete: Cascade)

  @@unique([enterprise_id, quotation_id])
  @@index([enterprise_id, created_at(sort: Desc)])
  @@index([enterprise_id, status, created_at(sort: Desc)])
  @@index([quotation_id])
  @@map("enterprise_quotation_requests")
}

enum proposal_status {
  PENDING
  ACCEPTED
  PAID
  COMPLETED
  REJECTED
  WITHDRAWN
}

model proposals {
  id                 String          @id @default(uuid()) @db.Uuid
  quotation_id       String          @db.Uuid
  enterprise_id      String          @db.Uuid
  item_name          String          @db.VarChar(255)
  description        String          @db.Text
  quantity           Int
  unit_price         Decimal         @db.Decimal(12, 2)
  total_amount       Decimal         @db.Decimal(12, 2)
  delivery_timeline  String          @db.VarChar(255)
  warranty_coverage  String          @db.VarChar(255)
  replacement_policy String          @db.VarChar(255)
  additional_notes   String?         @db.Text
  status             proposal_status @default(PENDING)
  created_at         DateTime        @default(now()) @db.Timestamptz
  updated_at         DateTime        @updatedAt @db.Timestamptz

  quotation  quotation_requests @relation(fields: [quotation_id], references: [id], onDelete: Cascade)
  enterprise enterprises        @relation(fields: [enterprise_id], references: [id], onDelete: Cascade)

  @@index([quotation_id])
  @@index([enterprise_id])
  @@map("proposals")
}
